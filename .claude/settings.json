{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/tdd/deny-test-edits.cjs" },
          { "type": "command", "command": "node .claude/hooks/tdd/guard-src-edit.cjs" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/tdd/guard-commit.cjs" }
        ]
      }
    ]
  }
}
